[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='hicolor'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/kelpie/kelpie-constellation.png'
picture-uri-dark='file:///usr/share/backgrounds/kelpie/kelpie-constellation.png'
picture-options='zoom'

[org/gnome/shell]
enabled-extensions=['kelpie-menu@kelpieos.local']

# Persistent bottom taskbar/dock (Dash to Dock)
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
autohide=false
intellihide=false
extend-height=false
show-trash=false
show-mounts=false
transparency-mode='FIXED'
background-opacity=0.28
