#!/bin/sh
set -eu

# Register Flathub in the image so GNOME Software can discover Flatpak apps.
if ! command -v flatpak >/dev/null 2>&1; then
    echo "Kelpie: Flatpak is missing; cannot register Flathub" >&2
    exit 1
fi
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak remotes --show-details | grep -q '^flathub[[:space:]]'
